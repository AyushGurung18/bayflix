{
  "name": "bayflix-api-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute bayflix-db --remote --file=./schema.sql",
