{
  "name": "bayflix-api-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute bayflix-db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute bayflix-db --local --file=./schema.sql",
    "seed": "tsx scripts/seed-catalog.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.0.0"
  }
}
