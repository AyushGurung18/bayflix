# TMDB API (server-only — never exposed to the browser, read by app/api/tmdb)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org

# Firebase web config (safe to expose to the client — this is how Firebase's
# JS SDK is designed to work; access is controlled by Firebase security rules,
# not by keeping these secret)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Cloudflare Worker / R2 that serves the HLS stream played by the in-app player
NEXT_PUBLIC_HLS_WORKER_BASE_URL=https://r2-video-worker.ayush201.workers.dev

# Cloudflare Worker (see cloudflare-worker/bayflix-api) backing watchlist,
# watched history, star ratings, IMDb/Rotten Tomatoes/Metacritic ratings
# (D1-cached OMDb — key lives on the worker now, not here), AI semantic
# search, and recommendations — D1 + Vectorize + Workers AI. That UI stays
# hidden until this is set; see cloudflare-worker/bayflix-api/README.md to
# deploy it.
NEXT_PUBLIC_BAYFLIX_API_BASE_URL=

# Firebase Admin SDK (server-only) — lets app/api/auth/magic-link mint
# sign-in links itself instead of Firebase emailing them from its shared,
# spam-flagged firebaseapp.com sender. From Firebase Console > Project
# Settings > Service Accounts > Generate new private key. Paste the private
# key with its \n sequences intact (as one line); this file unescapes them.
# Until all three of these are set, sign-in falls back to Firebase's default
# sender automatically — nothing breaks in the meantime.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Resend (server-only) — sends the branded sign-in email from your own
# verified domain. Free tier is plenty for a hobby project. RESEND_FROM_EMAIL
# must be an address on a domain verified in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Bayflix <sign-in@yourdomain.com>
